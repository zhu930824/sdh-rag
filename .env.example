# 环境变量配置文件
# 复制此文件为 .env 并根据实际情况修改配置

# ==================== 数据库配置 ====================
DB_USERNAME=root
DB_PASSWORD=
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=sdh_rag

# ==================== Redis 配置 ====================
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== Elasticsearch 配置 ====================
ELASTICSEARCH_URI=http://host.docker.internal:9200

# ==================== Neo4j 配置 ====================
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ==================== MinIO 配置 ====================
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=sdh-documents

# ==================== 后端服务配置 ====================
BACKEND_PORT=8989

# ==================== 前端服务配置 ====================
FRONTEND_PORT=80

# ==================== AI 服务配置 ====================
# 通义千问 API 密钥（必填）
DASHSCOPE_API_KEY=
# 使用 OpenAI 兼容服务时配置；不配置则回退到 DASHSCOPE_API_KEY
OPENAI_API_KEY=

# Agent runtime: keep legacy during rollout; enable agentscope after V31 migration and provider validation.
AGENT_RUNTIME=legacy

# ==================== JWT 配置 ====================
# 两个密钥必须不同，且至少 32 个随机字符
JWT_ADMIN_SECRET=
JWT_USER_SECRET=

# Webhook 默认只允许公网 HTTPS；内网部署需显式评估后开启
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_NETWORK=false

# Reliable job worker
JOB_DISPATCH_DELAY_MS=2000
JOB_DISPATCH_BATCH_SIZE=10
JOB_LEASE_SECONDS=600

# Reliable document indexing
KNOWLEDGE_DOCUMENT_INDEX_LOCK_MINUTES=120
KNOWLEDGE_DOCUMENT_RECOVERY_DELAY_MS=60000
KNOWLEDGE_DOCUMENT_RECOVERY_INITIAL_DELAY_MS=30000

# ==================== 可选配置 ====================
# WebSearch API 密钥（可选）
WEBSEARCH_API_KEY=

# 阿里云 OSS 配置（可选）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
